# ==============================================================================
# SecAudit / Aura Glass - Frontend Git Ignore Rules
# ==============================================================================

# Node dependencies
node_modules/
.pnp
.pnp.js

# Production build distributions
dist/
dist-ssr/

# Vite, roll-up & tooling cache
.vite/
.vite-temp/
.tmp/

# Environment files & secrets (Never commit credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Runtime logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
