# ==============================================================================
# SecAudit / Aura Glass - Backend Environment Configuration Template
# ==============================================================================

# Application Metadata
APP_NAME="Aura Glass - Autonomous Security Audit"
VERSION="1.0.0"
DEBUG=True

# Database Configuration (SQLite aiosqlite asynchronous path)
# Default local: ./secaudit.db (relative to backend folder)
# For Docker VPS: /app/data/secaudit.db
DATABASE_PATH="./secaudit.db"

# Supabase Cloud Database Integration (PostgreSQL / PostgREST)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# Google Gemini AI Integration (for SAST remediation & code patch synthesis)
# Obtain your key at: https://aistudio.google.com/
# Leave empty if you wish to run in heuristic-only offline mode
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

# Authentication & Session Security (JWT secret for user isolation)
# Generate a strong 32+ character random secret for production
AUTH_SECRET_KEY="your-super-secret-jwt-key-change-in-production"
AUTH_TOKEN_EXPIRE_HOURS=72

# Audit Engine Defaults & Scope Permissions
DEMO_MODE=True
ALLOW_LOCAL_LAB=True
DEFAULT_ENTROPY_THRESHOLD=4.2

# Server Networking
HOST="0.0.0.0"
PORT=8000
