# ==============================================================================
# SecAudit / Aura Glass - Root Git Ignore Rules
# ==============================================================================

# Internal task tracking & temporary specifications
tasks/
target/
reports/

# Environment files & operational secrets (Never commit credentials)
.env
.env.*
*.env
*.env.local
!.env.example
!*.env.example
!backend/.env.example
!frontend/.env.example
*.pem
*.key

# Python bytecode, virtual environments & testing caches
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/

# Node.js dependencies & build outputs
node_modules/
*/node_modules/
dist/
*/dist/
dist-ssr/
*/dist-ssr/
.vite/
*/.vite/
.vite-temp/
*/.vite-temp/

# Databases & local state
*.db
*.db-journal
*.sqlite
*.sqlite3

# Logs & diagnostic outputs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & IDE metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
